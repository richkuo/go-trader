[Unit]
Description=Go Trading Bot (instance %i)
After=network.target

[Service]
Type=simple
User=go-trader
Group=go-trader
WorkingDirectory=/opt/go-trader-%i
StateDirectory=go-trader/%i go-trader/shared
ExecStart=/opt/go-trader-%i/go-trader --config /var/lib/go-trader/%i/config.json
Restart=always
RestartSec=10
RestartPreventExitStatus=78 79 80
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

EnvironmentFile=-/opt/go-trader-%i/.env

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/go-trader-%i/scheduler /opt/go-trader-%i/logs

[Install]
WantedBy=multi-user.target

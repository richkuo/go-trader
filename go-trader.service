[Unit]
Description=Go Trading Bot (Spot + Options)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/go-trader
ExecStart=/root/go-trader/go-trader --config /root/go-trader/scheduler/config.json
Restart=always
RestartSec=10
RestartPreventExitStatus=78 79 80
StandardOutput=journal
StandardError=journal

EnvironmentFile=-/root/go-trader/.env


[Install]
WantedBy=multi-user.target

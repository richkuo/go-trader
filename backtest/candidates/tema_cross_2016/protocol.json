  "costs": {
    "cached_stress_slippage_multiplier": 2,
    "text": "cached-path legs (proxy windows, every frame): net = Hyperliquid taker fee and the default 0.05% slippage; stress = 2 x the default slippage (the cached path has no half spread and a manifest cannot carry the venue-absent funding hours); gross = commission 0 and slippage 0 (the gross_edge_noise.py convention). Manifest legs: cost_multiplier 1 and 2."
  },
  "deployed_copy": "deployed_tema_cross_sanitized.json",
  "disclosures": [
    "closed-bar decisions are opt-in live and the deployed entries do not set them",
    "the paper regime_directional_policy is uncertified, so live runs it off; the arms run it off",
    "use_defaults resolves to the system ratchet ladders",
    "the venue windows lie inside oos",
    "live circuit-breaker and drawdown limits are not modelled",
    "the live higher-timeframe check fetches the last 60 buckets and also sees the bucket that closes at the decision bar, one bucket earlier than the shifted frozen series",
    "on the registry-close spot shape the higher-timeframe filter also suppresses the exit signal while the trend is up, as live does for that shape",
    "the live shape runs isolated margin at leverage 20 with a fixed margin per trade; the backtest uses 1000 USD of strategy cash"
  ],
  "fee_platform": "hyperliquid",
  "fidelity": {
    "agreement_threshold": 0.95,
    "engine_check_every": 25,
    "min_agreement_bars": 30,
    "proxy_windows": [
      "oos",
      "2023H2",
      "2024",
      "2025H1"
    ],
    "text": "for every composite window that a noise baseline or a judged arm reads: validate_frames on the pooled proxy windows and the venue tail with the frame's label limit as the lookback, plus the engine label check on every 25th bar; an agreement row for a judged ADX gate window; and a live-rule row for the frozen higher-timeframe trend (the 60 closed buckets the live filter fetches, through htf_trend_filter, against the frozen series at each bucket close) where a reader uses htf_filter. A row passes at agreement >= 0.95 on >= 30 bars.",
    "venue_windows": {
      "1h": [
        "tail"
      ],
      "30m": [
        "tail"
      ]
    }
  },

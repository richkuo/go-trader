{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/command_policy.py\"",
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "Checking the go-trader command policy"
          }
        ]
      }
    ]
  }
}
